# Base de datos (la crea/actualiza iniciar.py; en Docker usa el host "db")
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fashionstore
# 32+ caracteres; debe ser IDENTICO al jwt-secret de PostgREST
JWT_SECRET=cambia-esta-clave-secreta-antes-de-produccion
PORT=3000
FASTAPI_URL=http://localhost:8000
# URLs publicas (para enlaces de pago y retornos). En Codespaces/produccion pon las URLs reales.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173

# --- Pagos -------------------------------------------------------------------
# sandbox = pasarelas simuladas (no cobra nada; sirve para demo/examen)
# produccion = usa las credenciales reales de abajo
PAGOS_MODO=sandbox
TIPO_CAMBIO_USD=6.96
PAGO_HOLD_MINUTOS=30
LIBELULA_APPKEY=
LIBELULA_BASE_URL=https://api.libelula.bo
LIBELULA_WEBHOOK_TOKEN=cambia-este-token
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Reservas ------------------------------------------------------------------
RESERVA_MAX_DIAS=7
RESERVA_GRACIA_HORAS=2

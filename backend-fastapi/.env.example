DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fashionstore
PORT=8000
# Opcional: con clave, el asistente y los reportes usan un modelo de lenguaje (Gemini). Sin clave funcionan con reglas/plantillas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Opcional: secreto compartido con la API comercial (cabecera X-Internal-Key)
IA_INTERNAL_KEY=
# Carpeta con las ilustraciones de prendas (para medir proporciones del overlay AR)
ASSETS_DIR=../backend-nest/public
